{
	"name": "@maximiliana/n8n-nodes-proget",
	"version": "0.1.0",
	"description": "n8n community nodes for the Proget MDM: devices, applications (APK upload), activations and auto-enrollment",
	"keywords": [
		"n8n-community-node-package",
		"proget",
		"mdm",
		"android",
		"apk"
	],
	"license": "MIT",
	"homepage": "https://github.com/maximiliana-dev",
	"author": {
		"name": "Maximiliana",
		"email": "pedro@maximiliana.es"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/maximiliana-dev/n8n-nodes-proget.git"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "tsc && node scripts/copy-icons.mjs",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"test": "node --import tsx --test \"nodes/**/*.test.ts\"",
		"prepublishOnly": "pnpm build && eslint -c eslint.config.prepublish.mjs nodes credentials package.json"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/Proget/ProgetApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Proget/Proget.node.js"
		]
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.0",
		"@types/node": "^22.15.0",
		"@typescript-eslint/parser": "^8.35.0",
		"eslint": "^9.39.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.7",
		"n8n-workflow": "~2.17.2",
		"prettier": "^3.3.2",
		"tsx": "^4.19.0",
		"typescript": "^5.5.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
